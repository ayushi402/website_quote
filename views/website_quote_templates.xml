    <template id="website_quote_success" name="Website Quote Success">
        <t t-call="website.layout">
            <div class="container mt16 mb16">
                <div class="text-center py-5">
                    <h1>Thank You!</h1>
                    <p class="lead">Your quote request is being processed by our team.</p>
                    <p>
                        Quotation / Reference:
                        <strong t-esc="order.name or order.client_order_ref or 'Quote'"/>
                    </p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a class="btn btn-primary" href="/shop">Continue Shop</a>
                        <a class="btn btn-outline-primary" href="/my/orders">My Orders</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="website_quote_cart_my_orders" inherit_id="website_sale.cart" name="Website Quote Cart My Orders Link">
        <xpath expr="//div[@id='shop_cart']" position="inside">
            <div class="mt-3">
                <a class="btn btn-outline-primary" href="/my/orders">My Orders</a>
            </div>
        </xpath>
    </template>



    <template id="website_quote_navigation_buttons"
              inherit_id="website_sale.navigation_buttons"
              name="Website Quote Navigation Button">

        <xpath expr="//a[@name='website_sale_main_button']" position="replace">
            <t t-if="request.env['ir.config_parameter'].sudo().get_param('website_quote.disable_checkout') == 'True' and current_website_checkout_step_href == '/shop/cart'">
                <a role="button" name="website_sale_main_button"
                   t-attf-class="btn btn-primary #{not website_sale_order._is_cart_ready() and 'disabled'} w-100"
                   t-att-href="next_website_checkout_step_href">
                    <span>Get Quote</span>
                    <i class="fa fa-angle-right ms-2 fw-light"/>
                </a>
            </t>
            <t t-elif="request.env['ir.config_parameter'].sudo().get_param('website_quote.disable_checkout') == 'True' and current_website_checkout_step_href == '/shop/extra_info'">
                <a role="button" name="website_sale_main_button"
                   t-attf-class="btn btn-primary #{not website_sale_order._is_cart_ready() and 'disabled'} w-100"
                   href="/shop/quote">
                    <span>Get Quote</span>
                    <i class="fa fa-angle-right ms-2 fw-light"/>
                </a>
            </t>
            <t t-else="">
                <a role="button" name="website_sale_main_button"
                   t-attf-class="btn btn-primary #{not website_sale_order._is_cart_ready() and 'disabled'} w-100"
                   t-att-href="next_website_checkout_step_href">
                    <t t-if="request.env['ir.config_parameter'].sudo().get_param('website_quote.disable_checkout') == 'True' and current_website_checkout_step_href == '/shop/checkout'">
                        <span>Get Quote</span>
                    </t>
                    <t t-else="">
                        <span t-field="next_website_checkout_step.main_button_label"/>
                    </t>
                    <i class="fa fa-angle-right ms-2 fw-light"/>
                </a>
            </t>
        </xpath>
    </template>


    <record id="email_template_quote_request" model="mail.template">
        <field name="name">Website Quote Request Confirmation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Your quote request has been received</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; background-color: #f4f4f4;">
                <div style="max-width: 650px; margin: 0 auto; background-color: #fff; font-family: Arial, sans-serif; color: #333; padding: 24px;">
                    <h2 style="margin-top: 0;">Thank you for your quote request!</h2>
                    <p>We have received your request and our team will get back with more details soon.</p>
                    <p>Your quotation reference is
                        <strong>
                            <t t-out="object.name"/>
                        </strong>
                        .
                    </p>
                    <p>Thank you for your interest in our products.</p>
                </div>
            </div>
        </field>
    </record>
</odoo>


