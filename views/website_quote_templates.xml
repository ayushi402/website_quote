<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quote cart page -->
    <template id="website_quote_cart" name="Website Quote Cart">
        <t t-call="website.layout">
            <div class="container mt16 mb16">
                <h1>Quote Review</h1>

                <form action="/shop/quote/submit" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="products" t-as="p">
                                <td>
                                    <t t-esc="p['product'].display_name"/>
                                </td>
                                <td>
                                    <input t-att-name="'quantity_%s' % p['product'].id" type="number" min="0" step="1"
                                           t-att-value="int(p['quantity'])" class="form-control"/>
                                </td>
                                <td>
                                    <t t-esc="p['price']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex mt8">
                        <a class="btn btn-secondary mr8" href="/shop">Continue Shopping</a>
                        <a class="btn btn-outline-primary mr8" href="/my/orders">My Orders</a>
                        <button class="btn btn-primary" type="submit">Quote Submit</button>
                    </div>
                </form>
            </div>
        </t>
    </template>


    <template id="website_quote_extra_info" inherit_id="website_sale.extra_info" name="Website Quote Extra Info">
        <xpath expr="//form" position="replace">
            <form action="/shop/quote" method="post" enctype="multipart/form-data"
                  class="o_mark_required s_website_form_no_recaptcha" data-mark="*">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="client_order_ref">Your Reference</label>
                        <input id="client_order_ref" type="text" class="form-control" name="client_order_ref"
                               t-att-value="order.client_order_ref or ''"/>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="feedback">Feedback</label>
                        <textarea id="feedback" class="form-control" name="feedback" rows="4">
                            <t t-esc="''"/>
                        </textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="document">Document Upload</label>
                        <input id="document" type="file" class="form-control" name="document"/>
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary">Get Quote</button>
                    </div>
                </div>
            </form>
        </xpath>
    </template>

