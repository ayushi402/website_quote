<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_return_order_detail_form" model="ir.ui.view">
        <field name="name">return.order.detail.form</field>
        <field name="model">return.order.detail</field>
        <field name="arch" type="xml">
            <form string="Return Order">
                <group>
                    <field name="sale_order_id"/>
                    <field name="request_type_id"/>
                    <field name="product_id"/>
                    <field name="product_qty"/>
                    <field name="return_quantity"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_submit_return" type="object" string="Submit Return" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_return_order_detail" model="ir.actions.act_window">
        <field name="name">Return Order</field>
        <field name="res_model">return.order.detail</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_return_order_detail_form"/>
        <field name="target">new</field>
    </record>

</odoo>
